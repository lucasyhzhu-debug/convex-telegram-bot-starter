# Required — get this from BotFather
TELEGRAM_BOT_TOKEN=

# 64-hex-char shared secret for webhook auth. Generate with: node scripts/new-webhook-secret.mjs
TELEGRAM_WEBHOOK_SECRET=

# ── Simple single-chat setup (v1 path) ───────────────────────────────────────
# The chat ID of the group/channel the bot posts to. Get it from getUpdates after
# mentioning the bot. Supergroups start with -100. The hello-world / pack-list
# examples read this directly. NOT required if you use self-registration (below).
TELEGRAM_CHAT_ID=

# ── Self-registration / multi-chat routing (v2 path) ─────────────────────────
# ADMIN_KEY gates the public admin* functions that back the React admin app.
# Generate one with: node scripts/new-webhook-secret.mjs  (and set it via
# `npx convex env set ADMIN_KEY <secret>`). Without it, all admin* calls are refused.
ADMIN_KEY=

# Your bot's @username WITHOUT the @ (e.g. MyOpsBot). Used in /start + test-send text.
TELEGRAM_BOT_USERNAME=

# URL the bot puts in its /register reply, linking to the admin UI.
# Defaults to http://localhost:5173/admin/telegram-chats for local dev.
TELEGRAM_ADMIN_URL=

# Migration shim: if set, getChatIdByRole falls back to TELEGRAM_CHAT_ID for THIS
# one role when no chat is assigned to it yet. Lets a feed keep working while you
# migrate it onto the registry. Leave unset on a greenfield install.
TELEGRAM_FALLBACK_ROLE=

# Optional — IANA timezone for pack-list header dates + end-of-day cutoff.
# Default UTC. Examples: "Asia/Jakarta" (UTC+7), "America/New_York", "Europe/Berlin".
PACK_LIST_TIMEZONE=

# ── React admin app (Vite) ───────────────────────────────────────────────────
# Vite reads this at build time (note the VITE_ prefix). Get the deployment URL
# from `npx convex dev` output or the dashboard.
VITE_CONVEX_URL=
