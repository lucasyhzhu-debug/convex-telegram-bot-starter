# Required — get these from BotFather
TELEGRAM_BOT_TOKEN=

# The chat ID of the group/channel the bot posts to.
# Get it from getUpdates after mentioning the bot. Supergroups start with -100.
TELEGRAM_CHAT_ID=

# 64-hex-char shared secret. Generate with: node scripts/new-webhook-secret.mjs
TELEGRAM_WEBHOOK_SECRET=

# Optional — IANA timezone for pack-list header dates + end-of-day cutoff.
# Default UTC. Examples: "Asia/Jakarta" (UTC+7), "America/New_York", "Europe/Berlin".
PACK_LIST_TIMEZONE=
