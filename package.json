{
  "name": "convex-telegram-bot-starter",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "Convex-backed Telegram bot starter: scheduled digests + slash commands + self-registering multi-chat routing, with a React admin UI, playbook, and guardrails.",
  "repository": "https://github.com/lucasyhzhu-debug/convex-telegram-bot-starter",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "npx convex dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "type-check:web": "tsc --noEmit -p tsconfig.app.json",
    "verify-secrets": "node scripts/verify-no-secrets.mjs --full",
    "prepare": "husky"
  },
  "dependencies": {
    "convex": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "convex-test": "^0.0.34",
    "husky": "^9.1.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
